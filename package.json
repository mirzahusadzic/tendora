{
  "name": "tendora",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal workbench for developing knowledge through natural language, with traceable reasoning across roles.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirzahusadzic/tendora.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.mjs\" \"docs/**/*.md\" \"*.md\" \".github/workflows/*.yml\" package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.mjs\" \"docs/**/*.md\" \"*.md\" \".github/workflows/*.yml\" package.json .prettierrc.json",
    "setup:python": "node src/models/setup-python.mjs",
    "check": "node test/run.mjs",
    "test": "node test/run.mjs",
    "capture:workbench": "node tools/capture-workbench.mjs",
    "workbench": "node src/tui/workbench.mjs",
    "engine": "node src/cli/engine.mjs",
    "setup:bolinas": ".venv/bin/python tools/bolinas.py install",
    "check:research": "node test/run.mjs research"
  },
  "dependencies": {
    "sqlite-vec": "0.1.9",
    "terminal-kit": "^3.1.4"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
